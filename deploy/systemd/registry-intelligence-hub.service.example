# Example systemd unit — Registry Intelligence Hub (optional alternate hosts)
# srv766238 uses PM2 (deploy/ecosystem.config.cjs.example, cwd /root/registry_hub), not systemd.
# Install on Ubuntu hosts that prefer systemd (adjust User, WorkingDirectory, EnvironmentFile).
#
#   sudo cp deploy/systemd/registry-intelligence-hub.service.example \
#     /etc/systemd/system/registry-intelligence-hub.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now registry-intelligence-hub
#
# After every `npm run build`, restart so HTML and basePath-prefixed /_next/static stay aligned.
# Next.js basePath is /tools/registry-intelligence-hub — nginx must proxy only that prefix (no root /_next/ location).

[Unit]
Description=Registry Intelligence Hub (Next.js production)
After=network.target

[Service]
Type=simple
User=forgeforward
Group=forgeforward
WorkingDirectory=/opt/registry-intelligence-hub
# srv766238: use /root/registry_hub under PM2 instead — do not assume /opt on that VPS.
EnvironmentFile=-/etc/registry-intelligence-hub/env
Environment=NODE_ENV=production
Environment=HUB_HOST=127.0.0.1
Environment=HUB_PORT=43123
ExecStart=/usr/bin/npx next start -H ${HUB_HOST} -p ${HUB_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
