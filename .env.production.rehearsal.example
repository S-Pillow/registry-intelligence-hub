# Registry Intelligence Hub — production REHEARSAL deploy (ForgeForward / Ubuntu)
# Copy to a host-local file (e.g. /etc/registry-intelligence-hub/env) — never commit secrets.
#
# Rehearsal default: 12-app synthetic 2026 fixture + three approved 2012 baseline counts.
# Do NOT set claim or application payload pins until steward-approved Reveal Day promotion.

NODE_ENV=production

# Hub listen address (ForgeForward nginx ^~ /tools/registry-intelligence-hub/ → this upstream)
# Next.js basePath is /tools/registry-intelligence-hub — assets use that prefix, not site-root /_next/.
HUB_HOST=127.0.0.1
HUB_PORT=43123

# --- Leave UNSET for rehearsal (required) ---
# REGISTRY_HUB_CLAIM_ACTUALITY_STATE_PATH=
# REGISTRY_HUB_CLAIM_ACTUALITY_STATE_JSON=
# REGISTRY_HUB_APPLICATION_PAYLOAD_PATH=
# REGISTRY_HUB_APPLICATION_PAYLOAD_JSON=

# Ensure no accidental promotion file on the host (from Hub cwd, e.g. /root/registry_hub on srv766238):
#   rm -f .data/reveal-2026/claim-actuality-state.json
# Do not deploy drill/staging payload paths to production rehearsal.
